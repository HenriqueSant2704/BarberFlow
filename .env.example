# Copie este arquivo para ".env" e preencha.

# String de conexão do Neon (Dashboard do Neon > Connect > copie a "connection string").
# No final dela, troque "sslmode=require" por "sslmode=verify-full" (evita um aviso de segurança).
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full

# Uma frase longa e aleatória. Serve para assinar os logins. Nunca compartilhe.
JWT_SECRET=troque-por-uma-frase-bem-grande-e-aleatoria

# Login inicial do barbeiro (usado só na primeira vez que roda "npm run db:setup").
# Depois ele troca a senha pelo próprio painel, em "Meu perfil".
ADMIN_USER=barbeiro
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Barbeiro

# Porta do servidor
PORT=3000

# Fuso horário da barbearia
TZ_BARBEARIA=America/Sao_Paulo
